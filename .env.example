# Application
APP_NAME=AI-Powered Data Lakehouse Analytics Platform
ENVIRONMENT=local
LOG_LEVEL=INFO

# Paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
WAREHOUSE_DIR=warehouse
CHECKPOINT_DIR=checkpoints
MODEL_DIR=models

# Spark
SPARK_MASTER_URL=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=8

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CUSTOMER_EVENTS_TOPIC=customer-events
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_PAYMENT_EVENTS_TOPIC=payment-events
KAFKA_INVENTORY_EVENTS_TOPIC=inventory-events
STREAMING_WATERMARK_DELAY=10 minutes
STREAMING_WINDOW_DURATION=5 minutes
STREAMING_SLIDE_DURATION=1 minute

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lakehouse_analytics
POSTGRES_USER=lakehouse_user
POSTGRES_PASSWORD=change_me
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_CONNECT_TIMEOUT=10

# Analytics API
# Leave empty for direct PostgreSQL access, or set to http://localhost:8000 locally.
ANALYTICS_API_URL=

# GenAI
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_before_running_airflow
AIRFLOW_ADMIN_FIRSTNAME=Lake
AIRFLOW_ADMIN_LASTNAME=House
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Streaming demo
EVENT_RATE=20
REALTIME_LOAD_INTERVAL_SECONDS=60

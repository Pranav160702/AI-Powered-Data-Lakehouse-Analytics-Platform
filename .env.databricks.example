# Databricks-on-AWS runtime settings.
#
# Recommended storage pattern:
# - Create an S3 bucket/prefix for the lakehouse.
# - Expose it to Databricks through a Unity Catalog external volume or DBFS mount.
# - Use that mounted/volume filesystem path below so the existing Python scripts work
#   without code changes while data is stored in S3 underneath.

APP_NAME=AI-Powered Data Lakehouse Analytics Platform
ENVIRONMENT=databricks
LOG_LEVEL=INFO

# Example Unity Catalog volume path backed by S3:
# /Volumes/<catalog>/<schema>/<volume>/ai-powered-lakehouse
LAKEHOUSE_ROOT=/Volumes/main/lakehouse/ai_powered_lakehouse
DATA_DIR=/Volumes/main/lakehouse/ai_powered_lakehouse/data
RAW_DATA_DIR=/Volumes/main/lakehouse/ai_powered_lakehouse/data/raw
WAREHOUSE_DIR=/Volumes/main/lakehouse/ai_powered_lakehouse/warehouse
CHECKPOINT_DIR=/Volumes/main/lakehouse/ai_powered_lakehouse/checkpoints
MODEL_DIR=/Volumes/main/lakehouse/ai_powered_lakehouse/models

# Databricks clusters should normally use the cluster Spark master.
SPARK_MASTER_URL=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SQL_SHUFFLE_PARTITIONS=64

# Use Amazon MSK, Confluent Cloud, or another reachable Kafka endpoint.
KAFKA_BOOTSTRAP_SERVERS=your-msk-bootstrap-brokers:9092
KAFKA_CUSTOMER_EVENTS_TOPIC=customer-events
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_PAYMENT_EVENTS_TOPIC=payment-events
KAFKA_INVENTORY_EVENTS_TOPIC=inventory-events
STREAMING_WATERMARK_DELAY=10 minutes
STREAMING_WINDOW_DURATION=5 minutes
STREAMING_SLIDE_DURATION=1 minute

# Use RDS PostgreSQL, Aurora PostgreSQL, or another reachable serving database.
POSTGRES_HOST=your-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=lakehouse_analytics
POSTGRES_USER=lakehouse_user
POSTGRES_PASSWORD=replace_with_secret_reference_or_runtime_secret
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_CONNECT_TIMEOUT=10

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

EVENT_RATE=20
REALTIME_LOAD_INTERVAL_SECONDS=60
